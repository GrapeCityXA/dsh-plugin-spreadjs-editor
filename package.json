{
  "name": "dsh-spreadjs-editor",
  "version": "0.1.0",
  "description": "DeepSeek Harness Web UI plugin: browse Excel / CSV / SJS files in the task workspace with SpreadJS.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "react": "^18.0.0"
  },
  "dependencies": {
    "@grapecity/spread-excelio": "18.2.5",
    "@grapecity/spread-sheets": "18.2.5",
    "@grapecity/spread-sheets-resources-zh": "18.2.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0",
    "unrun": "^0.3.1",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
