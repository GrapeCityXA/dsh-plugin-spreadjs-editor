{
  "name": "@grapecity-software/dsh-spreadjs-editor",
  "version": "0.1.3",
  "description": "DeepSeek Harness Web UI plugin: SpreadJS viewer registered through dsh-better-sidebar (ui-all).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "webui",
    "plugin",
    "spreadjs",
    "excel"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/licenses",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/copy-notices.mjs",
    "grapecity:update": "node scripts/update-grapecity.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && node scripts/smoke-client.mjs && node scripts/smoke-node.mjs && npm run verify:package",
    "rebuild": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GrapeCityXA/dsh-plugin-spreadjs-editor.git"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2",
    "dsh-better-sidebar": ">=0.6.0",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@grapecity-software/spread-excelio": "19.1.4",
    "@grapecity-software/spread-sheets": "19.1.4",
    "@grapecity-software/spread-sheets-io": "19.1.4",
    "@grapecity-software/spread-sheets-resources-zh": "19.1.4",
    "@grapecity-software/spread-sheets-designer": "19.1.4",
    "@grapecity-software/spread-sheets-designer-resources-cn": "19.1.4",
    "@grapecity-software/spread-sheets-shapes": "19.1.4",
    "@grapecity-software/spread-sheets-charts": "19.1.4",
    "@grapecity-software/spread-sheets-slicers": "19.1.4",
    "@grapecity-software/spread-sheets-sparklines": "19.1.4",
    "@grapecity-software/spread-sheets-print": "19.1.4",
    "@grapecity-software/spread-sheets-pdf": "19.1.4",
    "@grapecity-software/spread-sheets-barcode": "19.1.4",
    "@grapecity-software/spread-sheets-formula-panel": "19.1.4",
    "@grapecity-software/spread-sheets-pivot-addon": "19.1.4",
    "@grapecity-software/spread-sheets-tablesheet": "19.1.4",
    "@grapecity-software/spread-sheets-datacharts-addon": "19.1.4",
    "@grapecity-software/spread-sheets-ganttsheet": "19.1.4",
    "@grapecity-software/spread-sheets-reportsheet-addon": "19.1.4",
    "@grapecity-software/spread-sheets-languagepackages": "19.1.4",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0",
    "unrun": "^0.3.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.2.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
